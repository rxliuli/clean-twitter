    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-use": "^17.6.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@extport/wxt": "^0.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
