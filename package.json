{
  "name": "clean-twitter",
  "description": "Clean up some annoying elements on Twitter and make your Twitter experience cleaner",
  "private": true,
  "version": "0.19.9",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
